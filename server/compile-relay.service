# Compile invite-only online relay (server/relay.py), sandboxed.
# Install: see server/README.md
[Unit]
Description=Compile online relay (invite-only)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=compile-relay
Group=compile-relay
EnvironmentFile=/etc/compile-relay/relay.env
Environment=RELAY_HOST=127.0.0.1
Environment=RELAY_PORT=8795
Environment=RELAY_PRIVATE_PORT=8796
Environment=RELAY_ORIGINS=https://valkiii.github.io
Environment=RELAY_STATE=/var/lib/compile-relay/rooms.json
Environment=RELAY_ART_DIR=/opt/compile-relay/art
ExecStart=/opt/compile-relay/venv/bin/python /opt/compile-relay/relay.py
Restart=on-failure
RestartSec=5
StateDirectory=compile-relay
StateDirectoryMode=0700
UMask=0077

# Sandbox: no privileges, read-only system, no access to /home, only localhost networking
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=128M
TasksMax=32
CPUQuota=50%

[Install]
WantedBy=multi-user.target
